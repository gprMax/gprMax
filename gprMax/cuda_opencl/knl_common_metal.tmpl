{% extends "knl_common_base.tmpl" %}

{% block header %}
#include <metal_stdlib>
using namespace metal;

// Metal Shading Language has no native complex-number type (unlike CUDA's
// pycuda::complex<T> or OpenCL's pyopencl-complex.h) - this is used for
// Lorentz/Drude dispersive materials (Debye-only models never reference
// this; their $COMPLEX substitutes to a plain float). Metal is always
// single precision (see the ValueError raised in SimulationConfig for
// any double-precision Metal request), so a single concrete float-based
// struct is sufficient - no template needed.
struct gprMaxComplex {
    float re;
    float im;

    float real() const {
        return re;
    }
};

inline gprMaxComplex operator+(gprMaxComplex a, gprMaxComplex b) {
    return gprMaxComplex{a.re + b.re, a.im + b.im};
}

inline gprMaxComplex operator-(gprMaxComplex a, gprMaxComplex b) {
    return gprMaxComplex{a.re - b.re, a.im - b.im};
}

inline gprMaxComplex operator*(gprMaxComplex a, gprMaxComplex b) {
    return gprMaxComplex{a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re};
}

inline gprMaxComplex operator*(gprMaxComplex a, float b) {
    return gprMaxComplex{a.re * b, a.im * b};
}

// Uniform dispersive arithmetic used by the shared CUDA/OpenCL/Metal
// field-update kernel. Metal's custom complex type provides these operators.
#define GPRMAX_CMUL(a, b) ((a) * (b))
#define GPRMAX_CRMUL(a, b) ((a) * (b))
#define GPRMAX_CADD(a, b) ((a) + (b))
#define GPRMAX_CSUB(a, b) ((a) - (b))
{% if DRUDELORENTZ %}
#define GPRMAX_CREAL(a) ((a).real())
{% else %}
#define GPRMAX_CREAL(a) (a)
{% endif %}
{% endblock header %}


{% block constmem %}
constant {{REAL}} updatecoeffsE[{{N_updatecoeffsE}}] =
{
    {% for i in updatecoeffsE %}
    {{i}},
    {% endfor %}
};

constant {{REAL}} updatecoeffsH[{{N_updatecoeffsH}}] =
{
    {% for i in updatecoeffsH %}
    {{i}},
    {% endfor %}
};
{% endblock constmem %}
