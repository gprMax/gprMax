#title: Example 2 - curved 2D dielectric waveguide eigenmode ports

#domain_mode: TM
#domain: 0.195 0.165 inf
#dx_dy_dz: 0.001 0.001 0.001
#time_window: 6e-9
#pml_cells: 5 5 0 5 5 0

#material: 9 0 1 0 bend_core

## A 20 mm dielectric slab follows a 90 degree annular bend with a 15 mm
## centreline radius. The cylindrical-sector pair creates the curved core.
#box: 0 0.035 0 0.10 0.055 inf bend_core
#cylindrical_sector: z 0.10 0.060 0 inf 0.025 270 90 bend_core y
#cylindrical_sector: z 0.10 0.060 0 inf 0.005 270 90 free_space y
#box: 0.105 0.060 0 0.125 0.165 inf bend_core

## Excite mode 1 and monitor the two physical guided modes at both ports.
## Port 2 is normal to y because the bend rotates propagation through 90
## degrees.
#eigenmode_band: eigenmode_band 4e9 8e9 81
#eigenmode_port: 1 0.02 0.005 0 0.02 0.085 inf + 1,2 auto
#eigenmode_port: 2 0.075 0.160 0 0.155 0.160 inf - 1,2 auto
#eigenmode_excitation: 1 1 auto

#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 4e-10 curved_waveguide_400ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 7e-10 curved_waveguide_700ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1e-9 curved_waveguide_1000ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.3e-9 curved_waveguide_1300ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.6e-9 curved_waveguide_1600ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.9e-9 curved_waveguide_1900ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 2.2e-9 curved_waveguide_2200ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 2.5e-9 curved_waveguide_2500ps.h5
