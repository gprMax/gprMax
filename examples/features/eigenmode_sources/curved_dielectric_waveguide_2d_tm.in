#title: 2D TMz dielectric waveguide with a tight curved bend

#domain_mode: TM
#domain: 0.195 0.165 inf
#dx_dy_dz: 0.001 0.001 0.001
#time_window: 6e-9
#pml_cells: 5 5 0 5 5 0

#material: 9 0 1 0 bend_core
#waveform: ricker 1 5.5e9 eig_pulse

## A 20 mm dielectric slab follows a 90 degree annular bend with a 15 mm
## centreline radius. The cylindrical-sector pair creates the curved core.
#box: 0 0.035 0 0.10 0.055 inf bend_core
#cylindrical_sector: z 0.10 0.060 0 inf 0.025 270 90 bend_core y
#cylindrical_sector: z 0.10 0.060 0 inf 0.005 270 90 free_space y
#box: 0.105 0.060 0 0.125 0.165 inf bend_core

## Excite mode 1 and monitor modes 1 and 2 at both ports. Port 2 is normal to
## y because the bend rotates the propagation direction through 90 degrees.
#eigenmode_source: 0.02 0.005 0 0.02 0.085 inf + 1,2 1 4e9 5e9 6e9 7e9 8e9 eig_pulse 4e9 8e9 81 y
#eigenmode_rx: 0.075 0.160 0 0.155 0.160 inf - 2 2 4e9 5e9 6e9 7e9 8e9 output 4e9 8e9 81 y

#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 4e-10 curved_dielectric_waveguide_2d_tm_400ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 7e-10 curved_dielectric_waveguide_2d_tm_700ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1e-9 curved_dielectric_waveguide_2d_tm_1000ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.3e-9 curved_dielectric_waveguide_2d_tm_1300ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.6e-9 curved_dielectric_waveguide_2d_tm_1600ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.9e-9 curved_dielectric_waveguide_2d_tm_1900ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 2.2e-9 curved_dielectric_waveguide_2d_tm_2200ps.h5
