#title: Tapered dielectric rod antenna driven by an eigenmode port

#domain: 0.080 0.050 0.050
#dx_dy_dz: 0.001 0.001 0.001
#time_window: 3e-9
#pml_cells: 6

#material: 9 0 1 0 rod

## The uniform feed continues through the x0 PML. The eigenmode source stays
## outside the five-face Huygens volume; reflected guide waves leave through
## its omitted x0 face and are absorbed by the PML.
#cylinder: 0 0.025 0.025 0.035 0.025 0.025 0.005 rod
#cone: 0.035 0.025 0.025 0.055 0.025 0.025 0.005 0.0005 rod
#eigenmode_band: eigenmode_band 6.75e9 7.25e9 9
#eigenmode_port: 1 0.012 0.012 0.012 0.012 0.038 0.038 + 1 auto
#eigenmode_excitation: 1 1 auto

#ntff_surface: 0.028 0.008 0.008 0.060 0.042 0.042 radiation_surface x0
#ntff_frequency: radiation_surface antenna_band 6.75e9 6.8125e9 6.875e9 6.9375e9 7e9 7.0625e9 7.125e9 7.1875e9 7.25e9 rectangular
#ntff_antenna_ports: antenna_band port1
#ntff_far_field_array: 0 180 5 0 355 5 antenna_band full_sphere Etheta Ephi radiation_intensity directivity_dbi gain_dbi realized_gain_dbi radiation_efficiency total_efficiency

#geometry_view: 0 0 0 0.080 0.050 0.050 0.001 0.001 0.001 dielectric_rod_antenna_3d n
