#title: B-scan from a metal cylinder buried in a dielectric half-space
#domain_mode: TM
#domain: 0.240 0.210 inf
#dx_dy_dz: 0.002 0.002 0.002
#time_window: 3e-9

#material: 6 0 1 0 half_space

#waveform: ricker 1 1.5e9 my_ricker
#hertzian_dipole: z 0.040 0.170 inf my_ricker
#rx: 0.080 0.170 inf
#src_steps: 0.002 0 0
#rx_steps: 0.002 0 0

#box: 0 0 0 0.240 0.170 inf half_space
#cylinder: 0.120 0.080 0 0.120 0.080 inf 0.010 pec
