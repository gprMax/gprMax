#title: Broadband 2D TM dielectric waveguide with a small-radius curved bend

#domain_mode: TM
#domain: 0.195 0.165 inf
#dx_dy_dz: 0.001 0.001 0.001
#time_window: 6e-9
#pml_cells: 5 5 0 5 5 0

#material: 9 0 1 0 bend_core
#waveform: ricker 1 5.5e9 eig_pulse

## A 20 mm slab follows a tight 90 degree annular bend with 15 mm centreline radius.
#box: 0 0.035 0 0.10 0.055 inf bend_core
#cylindrical_sector: z 0.10 0.060 0 inf 0.025 270 90 bend_core y
#cylindrical_sector: z 0.10 0.060 0 inf 0.005 270 90 free_space y
#box: 0.105 0.060 0 0.125 0.165 inf bend_core

#eigenmode_source: 0.02 0.005 0 0.02 0.085 inf + 1,2 1 3e9 4e9 5e9 6e9 7e9 8e9 eig_pulse 3e9 8e9 101 y
#eigenmode_rx: 0.075 0.160 0 0.155 0.160 inf - 2 2 3e9 4e9 5e9 6e9 7e9 8e9 output 3e9 8e9 101 y

#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 1.2e-9 xy_center_1200ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 2.4e-9 xy_center_2400ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 3.6e-9 xy_center_3600ps.h5
#snapshot: 0 0 0 0.195 0.165 inf 0.001 0.001 0.001 4.8e-9 xy_center_4800ps.h5
