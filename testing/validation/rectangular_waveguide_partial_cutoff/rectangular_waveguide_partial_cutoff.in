#title: Straight rectangular PEC waveguide with a partially cutoff band

#domain: 0.028 0.008 0.006
#dx_dy_dz: 0.0002 0.0002 0.0002
#time_window: 4e-9
#pml_cells: 12 0 0 12 0 0

## Air-filled 6 mm x 4 mm rectangular PEC waveguide. The analytical TE10
## cutoff is c / (2a) = 24.9827048 GHz. One hundred uniformly spaced DFT
## points resolve the transition with seven bins below cutoff. The first
## propagating bin is 24.9924242 GHz.
#box: 0 0 0 0.028 0.001 0.006 pec
#box: 0 0.007 0 0.028 0.008 0.006 pec
#box: 0 0 0 0.028 0.008 0.001 pec
#box: 0 0 0.005 0.028 0.008 0.006 pec

#eigenmode_band: partial_cutoff_band 24.25e9 34.75e9 100

## Explicit anchors bracket the significant automatic-waveform spectrum and
## sample both sides of cutoff. All seven below-cutoff DFT frequencies are
## explicit monitor-reference candidates, so their generalized interpolation
## stays on one contiguous evanescent branch and never crosses cutoff. The
## first propagating DFT bin and the next eight DFT bins are also anchors
## because modal impedance changes rapidly near cutoff; approximately 0.5 GHz
## spacing is sufficient farther into the propagating band. Non-propagating
## candidate solves remain available only for the tracked monitor-reference
## bank, where E/H-balanced fields and neff are interpolated together. They
## are excluded from the one-watt source/power bank and never drive the TF/SF
## source; the resulting below-cutoff coefficients are not real-power waves.
#eigenmode_port: 1 0.004 0.001 0.001 0.004 0.007 0.005 + 1 15e9 20e9 24.25e9 24.3560606061e9 24.4621212121e9 24.5681818182e9 24.6742424242e9 24.7803030303e9 24.8863636364e9 24.9924242424e9 25.0984848485e9 25.2045454545e9 25.3106060606e9 25.4166666667e9 25.5227272727e9 25.6287878788e9 25.7348484848e9 25.8409090909e9 26.25e9 26.75e9 27.25e9 27.75e9 28.25e9 28.75e9 29.25e9 29.75e9 30.25e9 30.75e9 31.25e9 31.75e9 32.25e9 32.75e9 33.25e9 33.75e9 34.25e9 34.75e9 40e9 45e9 y
#eigenmode_port: 2 0.016 0.001 0.001 0.016 0.007 0.005 - 1 15e9 20e9 24.25e9 24.3560606061e9 24.4621212121e9 24.5681818182e9 24.6742424242e9 24.7803030303e9 24.8863636364e9 24.9924242424e9 25.0984848485e9 25.2045454545e9 25.3106060606e9 25.4166666667e9 25.5227272727e9 25.6287878788e9 25.7348484848e9 25.8409090909e9 26.25e9 26.75e9 27.25e9 27.75e9 28.25e9 28.75e9 29.25e9 29.75e9 30.25e9 30.75e9 31.25e9 31.75e9 32.25e9 32.75e9 33.25e9 33.75e9 34.25e9 34.75e9 40e9 45e9 y
#eigenmode_excitation: 1 1 auto y
