#title: 2D TEz eigenmode source in a 90 degree dielectric bend

#domain_mode: TE
#domain: 0.22 0.24 inf
#dx_dy_dz: 0.001 0.001 0.001
#time_window: 3.25e-9
#pml_cells: 5 5 0 5 5 0

#material: 9 0 1 0 bend_core
#waveform: contsine 1 5e9 eig_pulse

## A 20 mm core enters from the left, follows a 90 degree annular bend,
## and exits upward. The inner free-space sector hollows the outer sector.
#box: 0 0.035 0 0.10 0.055 inf bend_core
#cylindrical_sector: z 0.10 0.10 0 inf 0.065 270 90 bend_core
#cylindrical_sector: z 0.10 0.10 0 inf 0.045 270 90 free_space
#box: 0.145 0.10 0 0.165 0.24 inf bend_core

## The incoming-mode aperture includes 30 mm of air above and below the core.
#eigenmode_source: 0.02 0.005 0 0.02 0.085 inf + 0 5e9 eig_pulse y
#rx: 0.07 0.045 inf
#rx: 0.155 0.15 inf
#rx: 0.155 0.21 inf

#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 4e-10 xy_center_0400ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 8e-10 xy_center_0800ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 1.2e-9 xy_center_1200ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 1.6e-9 xy_center_1600ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 2e-9 xy_center_2000ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 2.4e-9 xy_center_2400ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 2.8e-9 xy_center_2800ps.h5
#snapshot: 0 0 0 0.22 0.24 inf 0.001 0.001 0.001 3.2e-9 xy_center_3200ps.h5
