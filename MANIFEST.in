include README.rst
include AUTHORS.rst
include setup.py
include build_config.py
include packaging_config.py
include packaging/build_macos_libomp.sh
include LICENSE
include MANIFEST.in

# All source files
recursive-include examples *
recursive-include gprMax *

# Exclude what we don't want to include
prune reframe_tests
prune testing
prune gprMax/toolboxes/STEPtoVoxel/examples/patch_antenna/output
prune gprMax/toolboxes/STLtoVoxel/examples/stl/point_cloud
exclude gprMax/toolboxes/STLtoVoxel/examples/bunny.vti
exclude gprMax/toolboxes/STLtoVoxel/examples/stl/Caribou_Lakes.stl
exclude gprMax/toolboxes/STLtoVoxel/examples/stl/Frenchman_Mountain.stl
exclude gprMax/toolboxes/STLtoVoxel/examples/stl/Mont_Blanc.stl
exclude gprMax/toolboxes/STLtoVoxel/examples/stl/Stanford_Bunny.h5
exclude gprMax/toolboxes/STLtoVoxel/examples/stl/Trinity_Alps.stl
global-exclude *.pyc *.pyo
global-exclude *.so *.pyd
global-exclude *.DS_Store
