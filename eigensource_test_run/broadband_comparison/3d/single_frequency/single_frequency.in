#title: 3D broadband pulse in a dielectric channel using one eigenmode solve

#domain: 2.0 0.8 0.8
#dx_dy_dz: 0.01 0.01 0.01
#time_window: 6.01e-9
#pml_cells: 10

#material: 4 0 1 0 channel_core
#waveform: gaussiandot 1 0.5e9 eig_pulse

## The unequal transverse dimensions remove the square-guide polarization
## degeneracy while retaining a simple dielectric-only channel.
#box: 0 0.28 0.32 2.0 0.52 0.48 channel_core

## Baseline 3D source: the broadband pulse uses a single modal profile.
#eigenmode_source: 0.20 0.10 0.10 0.20 0.70 0.70 + 0 0.5e9 eig_pulse

## Receiver planes integrate Sx = Ey*Hz - Ez*Hy over y and z.
#rx_array: 0.10 0.10 0.10 0.10 0.70 0.70 1 0.02 0.02
#rx_array: 0.50 0.10 0.10 0.50 0.70 0.70 1 0.02 0.02

#snapshot: 0 0 0.40 2.0 0.8 0.41 0.01 0.01 0.01 1.5e-9 xy_center_1500ps.h5
#snapshot: 0 0 0.40 2.0 0.8 0.41 0.01 0.01 0.01 3e-9 xy_center_3000ps.h5
#snapshot: 0 0 0.40 2.0 0.8 0.41 0.01 0.01 0.01 4.5e-9 xy_center_4500ps.h5
#snapshot: 0 0 0.40 2.0 0.8 0.41 0.01 0.01 0.01 5.9e-9 xy_center_5900ps.h5

#snapshot: 0 0.40 0 2.0 0.41 0.8 0.01 0.01 0.01 1.5e-9 xz_center_1500ps.h5
#snapshot: 0 0.40 0 2.0 0.41 0.8 0.01 0.01 0.01 3e-9 xz_center_3000ps.h5
#snapshot: 0 0.40 0 2.0 0.41 0.8 0.01 0.01 0.01 4.5e-9 xz_center_4500ps.h5
#snapshot: 0 0.40 0 2.0 0.41 0.8 0.01 0.01 0.01 5.9e-9 xz_center_5900ps.h5
